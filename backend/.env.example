# ==============================================================================
# WRH Full-Stack Compiler - Backend Environment Variables
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=wrh-insecure-dev-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------------------
# 3-Tier Database Configuration:
# Tier 1: Supabase / PostgreSQL Connection String (Recommended)
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Tier 2: Supabase Discrete Parameters (Alternative)
# SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your_secure_password
# SUPABASE_DB_SSLMODE=require

# Tier 3: Seamless Local SQLite Fallback
# If neither DATABASE_URL nor SUPABASE_DB_HOST is set, Django automatically uses backend/db.sqlite3.
# ------------------------------------------------------------------------------

# CORS Configuration (Next.js Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Automated Testing Override (Optional: Forces in-memory SQLite regardless of DB settings)
DJANGO_TESTING=False
