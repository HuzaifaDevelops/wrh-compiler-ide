# ==============================================================================
# WRH Full-Stack Compiler Web Application - Monorepo Root Environment Template
# Copy this file to .env in this directory, or use sub-directory .env files:
#   - Backend: copy to backend/.env
#   - Frontend: copy to frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Monorepo Global Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PROJECT_NAME="WRH Compiler Web Application"

# ------------------------------------------------------------------------------
# Django Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Django Security & Core
DEBUG=True
SECRET_KEY=django-insecure-wrh-compiler-change-me-in-production-1234567890abcdef
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Server Binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
# Allows Next.js frontend running on port 3000 (and 3001 fallback) to make requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# Database Configuration (3-Tier Resilient Fallback)
# ------------------------------------------------------------------------------
# Tier 1: Primary PostgreSQL URL (e.g., Supabase pooled connection string)
# If provided, this URL is parsed and used directly.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Tier 2: Discrete Supabase Parameters
# Used if DATABASE_URL is unset. Leave blank to trigger SQLite fallback.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Tier 3: Automatic SQLite Fallback
# If neither Tier 1 nor Tier 2 is fully configured, the application automatically
# initializes and connects to a local SQLite database at `backend/db.sqlite3`.

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (SimpleJWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional custom signing key; defaults to Django SECRET_KEY if left empty
JWT_SIGNING_KEY=

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
# REST API Base URL consumed by Axios client in the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
