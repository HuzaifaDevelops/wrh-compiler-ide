# ==============================================================================
# WRH Compiler Web Application - Monorepo Unified .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (NEVER commit secret keys, credentials, or tokens)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
backend/.env
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local
frontend/.env.test.local

# ------------------------------------------------------------------------------
# Python & Django Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# Django Database & Static Media
*.sqlite3
*.db
db.sqlite3
backend/db.sqlite3
media/
backend/media/
static_root/
backend/static_root/
staticfiles/
backend/staticfiles/

# Python Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# ------------------------------------------------------------------------------
# Node.js & Next.js Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js Build Outputs
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors & IDEs
.idea/
*.swp
*.swo
*~
.project
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
